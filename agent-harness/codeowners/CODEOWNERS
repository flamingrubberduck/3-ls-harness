# Example CODEOWNERS for the agent harness (GitHub and GitLab syntax).
# Replace the @your-org/... teams with your own, delete what does not apply,
# and see README.md in this folder for where the file goes on each platform.
#
# These paths match the company baseline's "Ask a human first" list:
# changes to them need approval from a named owner, whoever made them.
# When several patterns match a file, the last one wins.

# ---- Agent instructions ---------------------------------------------------
/.harness/                    @your-org/tech-leads
/AGENTS.md                    @your-org/tech-leads
/CLAUDE.md                    @your-org/tech-leads
CODEOWNERS                    @your-org/tech-leads

# ---- CI/CD pipelines ------------------------------------------------------
/.github/workflows/           @your-org/platform-team
/.gitlab-ci.yml               @your-org/platform-team
/.gitlab/                     @your-org/platform-team
/azure-pipelines*.yml         @your-org/platform-team
/Jenkinsfile                  @your-org/platform-team
/bitbucket-pipelines.yml      @your-org/platform-team
/.circleci/                   @your-org/platform-team

# ---- Infrastructure and deployment ---------------------------------------
Dockerfile*                   @your-org/platform-team
docker-compose*.yml           @your-org/platform-team
*.tf                          @your-org/platform-team
# Adjust to your repo's folder names:
/infra/                       @your-org/platform-team
/deploy/                      @your-org/platform-team

